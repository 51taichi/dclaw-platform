{
  "name": "dclaw-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "DClaw employee-facing WeChat mini-program",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp && node scripts/fix-wxml-imports.mjs",
    "build:weapp:device": "node scripts/build-weapp-device.mjs",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
