    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/webpack5-runner": "4.2.0",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "babel-preset-taro": "4.2.0",
    "eslint": "^9.25.0",
    "sass": "^1.77.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.4",
    "webpack": "5.91.0"
