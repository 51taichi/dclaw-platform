{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/contracts/local-execution/v1/tool-response.schema.json",
  "title": "DClaw local execution MCP tool response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard", "ok", "trace_id"],
  "properties": {
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "dclaw.local-execution"},
        "version": {"const": "1.1"}
      }
    },
    "ok": {"type": "boolean"},
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "data": {
      "oneOf": [
        {"$ref": "#/$defs/EnvironmentStatusData"},
        {"$ref": "#/$defs/CapabilitiesListData"},
        {"$ref": "#/$defs/RuntimePrepareData"},
        {"$ref": "#/$defs/TaskData"},
        {"$ref": "#/$defs/FileSelectionData"},
        {"$ref": "#/$defs/FileUploadData"},
        {"$ref": "#/$defs/ManagedArtifactsData"},
        {"$ref": "#/$defs/ManagedArtifactActionData"}
      ]
    },
    "error": {
      "$ref": "error-envelope.schema.json"
    }
  },
  "oneOf": [
    {
      "properties": {"ok": {"const": true}},
      "required": ["data"],
      "not": {"required": ["error"]}
    },
    {
      "properties": {"ok": {"const": false}},
      "required": ["error"],
      "not": {"required": ["data"]}
    }
  ],
  "$defs": {
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "display_name", "runner_version", "online", "last_seen"],
      "properties": {
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "runner_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "online": {"type": "boolean"},
        "last_seen": {"type": "integer", "minimum": 0}
      }
    },
    "EnvironmentStatusData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "reason", "protocol_version", "compatible",
        "minimum_runner_version", "bootstrap_session_id", "user_action", "devices"
      ],
      "properties": {
        "state": {"enum": ["ready", "device_not_ready", "runner_update_required", "protocol_incompatible"]},
        "reason": {"enum": ["none", "no_paired_device", "device_offline", "runner_version_too_old", "protocol_version_mismatch"]},
        "protocol_version": {"enum": ["1", "2"]},
        "compatible": {"type": "boolean"},
        "minimum_runner_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "bootstrap_session_id": {"type": ["string", "null"], "maxLength": 128},
        "user_action": {"enum": ["none", "open_dclaw", "update_dclaw", "contact_administrator"]},
        "devices": {"type": "array", "items": {"$ref": "#/$defs/Device"}}
      }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version", "package_id", "package_version"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$", "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 32},
        "package_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "package_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "CapabilitiesListData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_version", "availability", "capabilities", "device_count"],
      "properties": {
        "catalog_version": {"const": "1"},
        "availability": {"enum": ["available", "device_not_ready"]},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/Capability"}},
        "device_count": {"type": "integer", "minimum": 0}
      }
    },
    "RuntimePrepareData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "capability_id", "package_id", "package_version",
        "min_runner_version", "device_id", "runner_version", "user_action"
      ],
      "properties": {
        "state": {"enum": ["ready", "preparing", "device_not_ready", "runner_update_required"]},
        "capability_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "package_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "package_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "min_runner_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "device_id": {"type": ["string", "null"], "maxLength": 128},
        "runner_version": {"type": ["string", "null"], "maxLength": 64},
        "user_action": {"enum": ["none", "wait", "open_dclaw", "update_dclaw"]}
      }
    },
    "TaskData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "capability_id", "device_id", "status", "checkpoint",
        "result", "error", "created_at", "updated_at"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "capability_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["queued", "running", "awaiting_input", "cancelling", "succeeded", "failed", "cancelled"]},
        "checkpoint": {"type": ["object", "null"]},
        "result": {"type": ["object", "null"]},
        "error": {"type": ["object", "null"]},
        "created_at": {"type": "integer", "minimum": 0},
        "updated_at": {"type": "integer", "minimum": 0},
        "idempotent_replay": {"type": "boolean"}
      }
    },
    "LocalFile": {"type":"object","additionalProperties":false,"required":["local_file_ref","display_name","mime_type","size_bytes","device_id","last_modified_ms"],"properties":{"local_file_ref":{"type":"string","pattern":"^lfr_[A-Za-z0-9_-]{32,156}$"},"display_name":{"type":"string","minLength":1,"maxLength":255,"pattern":"^[^/\\\\\\u0000]+$"},"mime_type":{"type":"string","minLength":1,"maxLength":255},"size_bytes":{"type":"integer","minimum":0,"maximum":1099511627776},"device_id":{"type":"string","minLength":1,"maxLength":128},"last_modified_ms":{"type":"integer","minimum":0}}},
    "FileSelectionData": {"type":"object","additionalProperties":false,"required":["status","files"],"properties":{"status":{"enum":["selected","cancelled"]},"files":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/LocalFile"}},"expires_at":{"type":"integer","minimum":0}}},
    "FileUploadData": {"type":"object","additionalProperties":false,"required":["status","local_file_ref","size_bytes"],"properties":{"status":{"const":"uploaded"},"local_file_ref":{"type":"string","pattern":"^lfr_[A-Za-z0-9_-]{32,156}$"},"size_bytes":{"type":"integer","minimum":0}}},
    "ManagedArtifact": {"type":"object","additionalProperties":false,"required":["artifact_id","device_id","task_id","display_name","mime_type","size_bytes","created_at"],"properties":{"artifact_id":{"type":"string","pattern":"^artifact_[A-Za-z0-9_-]{32,156}$"},"device_id":{"type":"string","minLength":1,"maxLength":128},"task_id":{"type":"string","minLength":1,"maxLength":128},"display_name":{"type":"string","minLength":1,"maxLength":255,"pattern":"^[^/\\\\\\u0000]+$"},"mime_type":{"type":"string","minLength":1,"maxLength":255},"size_bytes":{"type":"integer","minimum":0,"maximum":1099511627776},"created_at":{"type":"integer","minimum":0}}},
    "ManagedArtifactsData": {"type":"object","additionalProperties":false,"required":["artifacts"],"properties":{"artifacts":{"type":"array","items":{"$ref":"#/$defs/ManagedArtifact"}}}},
    "ManagedArtifactActionData": {"type":"object","additionalProperties":false,"required":["status","artifact_id","action"],"properties":{"status":{"const":"ok"},"artifact_id":{"type":"string"},"action":{"enum":["preview","select","open_directory","delete"]},"file":{"$ref":"#/$defs/LocalFile"},"expires_at":{"type":"integer","minimum":0}}}
  }
}
