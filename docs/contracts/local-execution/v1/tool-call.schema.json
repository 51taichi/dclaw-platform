{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/contracts/local-execution/v1/tool-call.schema.json",
  "title": "DClaw local execution MCP tool call v1",
  "oneOf": [
    {"$ref": "#/$defs/EnvironmentStatusCall"},
    {"$ref": "#/$defs/CapabilitiesListCall"},
    {"$ref": "#/$defs/RuntimePrepareCall"},
    {"$ref": "#/$defs/TaskStartCall"},
    {"$ref": "#/$defs/TaskContinueCall"},
    {"$ref": "#/$defs/TaskStatusCall"},
    {"$ref": "#/$defs/TaskCancelCall"},
    {"$ref": "#/$defs/TaskResultCall"},
    {"$ref": "#/$defs/LocalFileSelectCall"},
    {"$ref": "#/$defs/LocalFileUploadCall"},
    {"$ref": "#/$defs/ManagedArtifactsListCall"},
    {"$ref": "#/$defs/ManagedArtifactActionCall"}
  ],
  "$defs": {
    "SessionToken": {"type": "string", "minLength": 1, "maxLength": 4096},
    "TaskId": {"type": "string", "minLength": 1, "maxLength": 128},
    "CapabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 128
    },
    "LocalFileRef": {"type":"string","pattern":"^lfr_[A-Za-z0-9_-]{32,156}$"},
    "LocalFileBindings": {
      "type":"object","maxProperties":20,"propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
      "additionalProperties":{"type":"object","additionalProperties":false,"required":["local_file_ref","access"],"properties":{"local_file_ref":{"$ref":"#/$defs/LocalFileRef"},"access":{"const":"read"}}}
    },
    "EnvironmentStatusCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {"const": "local_environment_status"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_protocol_version"],
          "properties": {
            "agent_protocol_version": {"type": "string", "minLength": 1, "maxLength": 32},
            "bootstrap_session_id": {
              "type": ["string", "null"],
              "maxLength": 128,
              "description": "Optional correlation value echoed unchanged by the platform. It grants no identity, pairing, installation, or session authority."
            },
            "wait_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 25,
              "description": "Maximum seconds to wait for the signed-in user's DClaw client to connect automatically."
            },
            "dclaw_session_token": {"$ref": "#/$defs/SessionToken"}
          }
        }
      }
    },
    "CapabilitiesListCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {"const": "local_capabilities_list"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "output_type": {"type": "string", "minLength": 1, "maxLength": 64},
            "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "dclaw_session_token": {"$ref": "#/$defs/SessionToken"}
          }
        }
      }
    },
    "RuntimePrepareCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {"const": "local_runtime_prepare"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability"],
          "properties": {
            "capability": {"$ref": "#/$defs/CapabilityId"},
            "dclaw_session_token": {"$ref": "#/$defs/SessionToken"}
          }
        }
      }
    },
    "TaskStartCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {"const": "local_task_start"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability_id", "input", "idempotency_key"],
          "properties": {
            "capability_id": {"$ref": "#/$defs/CapabilityId"},
            "input": {"type": "object"},
            "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
            "local_file_bindings": {"$ref":"#/$defs/LocalFileBindings"},
            "dclaw_session_token": {"$ref": "#/$defs/SessionToken"}
          }
        }
      }
    },
    "LocalFileSelectCall": {
      "type":"object","additionalProperties":false,"required":["tool","arguments"],
      "properties":{"tool":{"const":"local_file_select"},"arguments":{"type":"object","additionalProperties":false,"required":["interaction_id","selector"],"properties":{"interaction_id":{"type":"string","minLength":1,"maxLength":160},"selector":{"type":"object","additionalProperties":false,"properties":{"accept_mime_types":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":255}},"accept_extensions":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^\\.[A-Za-z0-9._+-]{1,31}$"}},"multiple":{"type":"boolean"},"min_files":{"type":"integer","minimum":1,"maximum":20},"max_files":{"type":"integer","minimum":1,"maximum":20},"max_file_size_bytes":{"type":"integer","minimum":1,"maximum":1099511627776},"max_total_size_bytes":{"type":"integer","minimum":1,"maximum":1099511627776}}},"dclaw_session_token":{"$ref":"#/$defs/SessionToken"}}}}
    },
    "LocalFileUploadCall": {
      "type":"object","additionalProperties":false,"required":["tool","arguments"],
      "properties":{"tool":{"const":"local_file_upload"},"arguments":{"type":"object","additionalProperties":false,"required":["local_file_ref","upload"],"properties":{"local_file_ref":{"$ref":"#/$defs/LocalFileRef"},"upload":{"type":"object","additionalProperties":false,"required":["url","allowed_domains"],"properties":{"url":{"type":"string","format":"uri","pattern":"^https://","maxLength":8192},"method":{"enum":["PUT","POST"]},"headers":{"type":"object","maxProperties":16,"additionalProperties":{"type":"string","maxLength":2048}},"allowed_domains":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":253}},"max_size_bytes":{"type":"integer","minimum":1,"maximum":1099511627776}}},"dclaw_session_token":{"$ref":"#/$defs/SessionToken"}}}}
    },
    "ManagedArtifactsListCall": {"type":"object","additionalProperties":false,"required":["tool","arguments"],"properties":{"tool":{"const":"managed_artifacts_list"},"arguments":{"type":"object","additionalProperties":false,"properties":{"dclaw_session_token":{"$ref":"#/$defs/SessionToken"}}}}},
    "ManagedArtifactActionCall": {"type":"object","additionalProperties":false,"required":["tool","arguments"],"properties":{"tool":{"const":"managed_artifact_action"},"arguments":{"type":"object","additionalProperties":false,"required":["artifact_id","action"],"properties":{"artifact_id":{"type":"string","pattern":"^artifact_[A-Za-z0-9_-]{32,156}$"},"action":{"enum":["preview","select","open_directory","delete"]},"dclaw_session_token":{"$ref":"#/$defs/SessionToken"}}}}},
    "TaskContinueCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {"const": "local_task_continue"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_id", "checkpoint_id", "input"],
          "properties": {
            "task_id": {"$ref": "#/$defs/TaskId"},
            "checkpoint_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "input": {"type": "object"},
            "local_file_bindings": {"$ref":"#/$defs/LocalFileBindings"},
            "dclaw_session_token": {"$ref": "#/$defs/SessionToken"}
          }
        }
      }
    },
    "TaskStatusCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {"const": "local_task_status"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {"$ref": "#/$defs/TaskId"},
            "current_task": {"type": "boolean"},
            "wait_seconds": {"type": "integer", "minimum": 0, "maximum": 25},
            "dclaw_session_token": {"$ref": "#/$defs/SessionToken"}
          },
          "oneOf": [
            {
              "required": ["task_id"],
              "properties": {"current_task": {"const": false}}
            },
            {
              "required": ["current_task"],
              "properties": {"current_task": {"const": true}},
              "not": {"required": ["task_id"]}
            }
          ]
        }
      }
    },
    "TaskCancelCall": {"$ref": "#/$defs/TaskIdOnlyCall", "unevaluatedProperties": false, "properties": {"tool": {"const": "local_task_cancel"}}},
    "TaskResultCall": {"$ref": "#/$defs/TaskIdOnlyCall", "unevaluatedProperties": false, "properties": {"tool": {"const": "local_task_result"}}},
    "TaskIdOnlyCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {"type": "string"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_id"],
          "properties": {
            "task_id": {"$ref": "#/$defs/TaskId"},
            "dclaw_session_token": {"$ref": "#/$defs/SessionToken"}
          }
        }
      }
    }
  }
}
