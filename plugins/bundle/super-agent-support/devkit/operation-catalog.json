{
  "catalog_version": "1",
  "owner": "dclaw.super-agent-support",
  "minimum_plugin_version": "1.17.0",
  "self_service_publication": {
    "package_type": "super_expert_public",
    "authentication": "DClaw signed-in user bearer token",
    "signer_registration": {
      "method": "POST",
      "path": "/api/user/super-expert-publishing/signers",
      "request_schema": "schemas/publishing-v1/signer-request.schema.json",
      "response_schema": "schemas/publishing-v1/signer-response.schema.json"
    },
    "release_upload": {
      "method": "POST",
      "path": "/api/user/super-expert-publishing/releases",
      "content_type": "multipart/form-data",
      "file_field": "file",
      "response_schema": "schemas/publishing-v1/release-response.schema.json",
      "effect": "verify, install, grant, activate, publish globally"
    },
    "owned_agents": {
      "method": "GET",
      "path": "/api/user/super-expert-publishing/agents"
    },
    "retry_activation": {
      "method": "POST",
      "path_template": "/api/user/super-expert-publishing/agents/{agent_id}/releases/{release_id}/activate",
      "response_schema": "schemas/publishing-v1/release-response.schema.json"
    }
  },
  "developer_reference_diagnostics": {
    "contract": "developer.runtime.diagnostics.by-reference/2",
    "minimum_plugin_version": "1.18.22",
    "method": "GET",
    "path_template": "/api/user/super-expert-publishing/runtime-diagnostics/v2/references/{invocation_id}?agent_id={agent_id}",
    "authentication": "signed-in owner of the expert",
    "request_schema": "schemas/runtime-diagnostics-v2/by-reference-request.schema.json",
    "response_schema": "schemas/runtime-diagnostics-v2/by-reference-response.schema.json",
    "error_schema": "schemas/runtime-diagnostics-v2/error.schema.json",
    "retention_days": 30,
    "limit_per_minute": 30
  },
  "developer_reference_diagnostics_v3": {
    "contract": "developer.runtime.diagnostics.by-reference/3",
    "minimum_plugin_version": "1.18.28",
    "method": "GET",
    "path_template": "/api/user/super-expert-publishing/runtime-diagnostics/v3/references/{invocation_id}?agent_id={agent_id}",
    "authentication": "signed-in owner of the expert",
    "request_schema": "schemas/runtime-diagnostics-v3/by-reference-request.schema.json",
    "response_schema": "schemas/runtime-diagnostics-v3/by-reference-response.schema.json",
    "error_schema": "schemas/runtime-diagnostics-v3/error.schema.json",
    "api_demo": "runtime_diagnostics_api_demo.py",
    "retention_days": 30,
    "limit_per_minute": 30
  },
  "developer_diagnostic_search": {
    "contract": "developer.runtime.diagnostics.search/1",
    "minimum_plugin_version": "1.18.28",
    "method": "GET",
    "path_template": "/api/user/super-expert-publishing/runtime-diagnostics/v1/search?agent_id={agent_id}&start={start}&end={end}",
    "authentication": "signed-in owner of the expert",
    "request_schema": "schemas/runtime-diagnostics-search-v1/request.schema.json",
    "response_schema": "schemas/runtime-diagnostics-search-v1/response.schema.json",
    "error_schema": "schemas/runtime-diagnostics-search-v1/error.schema.json",
    "api_demo": "runtime_diagnostics_api_demo.py",
    "maximum_window_hours": 24,
    "maximum_results": 50,
    "retention_days": 30,
    "limit_per_minute": 30
  },
  "developer_aigc_binding_lookup": {
    "contract": "developer.aigc.binding.lookup/1",
    "minimum_plugin_version": "1.18.36",
    "method": "GET",
    "path_template": "/api/user/super-expert-publishing/aigc-tasks/v1/sessions/{session_id}/binding?agent_id={agent_id}",
    "authentication": "signed-in owner of the expert",
    "request_schema": "schemas/developer-aigc-binding-v1/request.schema.json",
    "response_schema": "schemas/developer-aigc-binding-v1/response.schema.json",
    "api_demo": "aigc_binding_api_demo.py",
    "limit_per_minute": 30
  },
  "interaction_host": {
    "owner": "dclaw.super-agent-support",
    "transport": "sealed-agent-host.call",
    "catalog": {
      "capability_id": "interaction.capabilities.list/1",
      "request_schema": "schemas/interaction-capabilities-list-v1/request.schema.json",
      "response_schema": "schemas/interaction-capabilities-list-v1/response.schema.json",
      "live_card_schema_location": "components[].schema",
      "single_select_live_fixture": "fixtures/interaction-host-v1/single-select-live-catalog.json",
      "validation_reference": "validate_live_card.py",
      "api_demo": "interaction_card_api_demo.py"
    },
    "card_create": {
      "capability_id": "interaction.card.create/1",
      "request_schema": "schemas/interaction-card-create-v1/request.schema.json",
      "response_schema": "schemas/interaction-card-create-v1/response.schema.json",
      "created_receipt_schema": "schemas/interaction-card-receipt-v1/receipt.schema.json",
      "success_example": "examples/interaction-host-v1/single-select-success.json"
    }
  },
  "aigc_workflow_host": {
    "owner": "dclaw.super-agent-support",
    "model_tool_transport": "agent.execute(agent_loop)",
    "catalog_tool": "aigc_workflow_catalog",
    "create_tool": "aigc_workflow_create",
    "catalog_capability_id": "aigc.workflow.capabilities.list/1",
    "create_capability_id": "aigc.workflow.create/1",
    "live_workflow_schema_location": "aigc_workflow_catalog.workflow_schema",
    "live_node_catalog_location": "aigc_workflow_catalog.catalog.nodes",
    "snapshot": {
      "transport": "sealed-agent-host.call",
      "capability_id": "aigc.task.snapshot/1",
      "request_schema": "schemas/aigc-task-snapshot-v1/request.schema.json",
      "response_schema": "schemas/aigc-task-snapshot-v1/response.schema.json"
    },
    "binding_resolve": {
      "minimum_plugin_version": "1.18.36",
      "transport": "sealed-agent-host.call",
      "capability_id": "aigc.task.binding.resolve/1",
      "request_schema": "schemas/aigc-task-binding-v1/request.schema.json",
      "response_schema": "schemas/aigc-task-binding-v1/response.schema.json"
    },
    "assets": {
      "minimum_plugin_version": "1.18.31",
      "list_capability_id": "aigc.task.assets.list/1",
      "list_request_schema": "schemas/aigc-task-assets-v1/list-request.schema.json",
      "list_response_schema": "schemas/aigc-task-assets-v1/list-response.schema.json",
      "localize_capability_id": "aigc.task.assets.localize/1",
      "localize_request_schema": "schemas/aigc-task-assets-v1/localize-request.schema.json",
      "localize_response_schema": "schemas/local-task-host-v1/receipt.schema.json"
    },
    "api_demo": "aigc_workflow_api_demo.py",
    "example": "examples/aigc-workflow-v1/README.md",
    "snapshot_example": "examples/aigc-workflow-v1/submitted-snapshot.sample.json"
  },
  "local_task_host": {
    "owner": "dclaw.super-agent-support",
    "transport": "sealed-agent-host.call",
    "start_capability_id": "local.task.start/1",
    "read_capability_id": "local.task.read/1",
    "cancel_capability_id": "local.task.cancel/1",
    "start_request_schema": "schemas/local-task-host-v1/start-request.schema.json",
    "task_request_schema": "schemas/local-task-host-v1/task-request.schema.json",
    "receipt_schema": "schemas/local-task-host-v1/receipt.schema.json",
    "api_demo": "local_task_api_demo.py",
    "example": "examples/local-task-host-v1/README.md",
    "receipt_example": "examples/local-task-host-v1/task-success.sample.json"
  },
  "capability_id": "business.service.installation-identity/1",
  "capability_ids": [
    "business.service.installation-identity/1",
    "agent.outbound/1",
    "agent.outbound.stream/1",
    "resource.exchange/1"
  ],
  "local_capability_gateway": {
    "owner": "dclaw-platform",
    "endpoint_path": "/api/super-agent-support/mcp/",
    "transport": "streamable-http",
    "jsonrpc_version": "2.0",
    "session_mode": "stateless",
    "mcp_session_id_required": false,
    "agent_raw_jsonrpc_allowed": false,
    "host_sequence": [
      "initialize",
      "notifications/initialized",
      "tools/list",
      "tools/call"
    ],
    "request_headers": {
      "Content-Type": "application/json",
      "Accept": "application/json, text/event-stream"
    }
  },
  "platform_injected_arguments": ["dclaw_session_token"],
  "operations": [
    {
      "client_key": "business_identity.issue",
      "tool_name": "business_service_identity_issue",
      "input_schema": "schemas/business-identity-v1/issue-request.schema.json",
      "output_schema": "schemas/business-identity-v1/issue-response.schema.json",
      "must_precede": "business_identity.outbound"
    },
    {
      "client_key": "business_identity.outbound",
      "tool_name": "business_service_outbound_request",
      "input_schema": "schemas/business-identity-v1/outbound-request.schema.json",
      "output_schema": "schemas/business-identity-v1/outbound-response.schema.json",
      "requires_binding_from": "business_identity.issue"
    },
    {
      "client_key": "agent_outbound.request",
      "capability_id": "agent.outbound/1",
      "tool_name": "agent_outbound_request",
      "input_schema": "schemas/agent-outbound-v1/request.schema.json",
      "output_schema": "schemas/agent-outbound-v1/response.schema.json",
      "credential_binding_schema": "schemas/agent-outbound-v1/credential-binding.schema.json"
    },
    {
      "client_key": "agent_outbound.stream",
      "capability_id": "agent.outbound.stream/1",
      "tool_name": "agent_outbound_stream_request",
      "input_schema": "schemas/agent-outbound-stream-v1/request.schema.json",
      "output_schema": "schemas/agent-outbound-stream-v1/response.schema.json",
      "credential_binding_schema": "schemas/agent-outbound-v1/credential-binding.schema.json"
    },
    {
      "client_key": "resource.upload.create",
      "capability_id": "resource.exchange/1",
      "tool_name": "agent_resource_upload_create",
      "input_schema": "schemas/resource-exchange-v1/upload-create.schema.json",
      "output_schema": "schemas/resource-exchange-v1/upload-create-response.schema.json"
    },
    {
      "client_key": "resource.upload.complete",
      "capability_id": "resource.exchange/1",
      "tool_name": "agent_resource_upload_complete",
      "input_schema": "schemas/resource-exchange-v1/upload-complete.schema.json",
      "output_schema": "schemas/resource-exchange-v1/response.schema.json"
    },
    {
      "client_key": "resource.read",
      "capability_id": "resource.exchange/1",
      "tool_name": "agent_resource_read",
      "input_schema": "schemas/resource-exchange-v1/read.schema.json",
      "output_schema": "schemas/resource-exchange-v1/response.schema.json"
    },
    {
      "client_key": "resource.revoke",
      "capability_id": "resource.exchange/1",
      "tool_name": "agent_resource_revoke",
      "input_schema": "schemas/resource-exchange-v1/revoke.schema.json",
      "output_schema": "schemas/resource-exchange-v1/response.schema.json"
    }
  ],
  "controlled_outbound": {
    "authorization_owner": "dclaw-platform",
    "authorization_header": "Authorization",
    "authorization_format": "Bearer <assertion>",
    "authorization_cardinality": 1,
    "agent_authorization_allowed": false,
    "proxy_forwarding": "verbatim-single-value",
    "receiver_fail_closed_on": [
      "missing",
      "duplicate",
      "combined-multi-value",
      "non-bearer",
      "empty-token"
    ],
    "ordinary_log_or_trace_allowed": false,
    "url_boundary": "registered-audience-origin-and-path-subtree",
    "redirects_allowed": false,
    "request_body": "zero-or-one-of-json_body-or-text_body"
  },
  "agent_controlled_outbound": {
    "business_owner": "sealed-super-agent",
    "credential_owner": "agent-installation",
    "credential_injection": "transport-boundary-only",
    "agent_authentication_header_allowed": false,
    "local_helper_long_term_credential_allowed": false,
    "url_boundary": "credential-domain-allowlist",
    "method_boundary": "credential-method-allowlist",
    "redirects_allowed": false,
    "maximum_request_bytes": 1048576,
    "maximum_response_bytes": 1048576,
    "request_body": "zero-or-one-of-json_body-or-text_body"
  },
  "stable_error_schema": "schemas/business-identity-v1/error.schema.json",
  "agent_outbound_error_schema": "schemas/agent-outbound-v1/error.schema.json",
  "agent_outbound_stream_error_schema": "schemas/agent-outbound-stream-v1/error.schema.json",
  "resource_exchange_error_schema": "schemas/resource-exchange-v1/error.schema.json"
}
