{
  "catalog_version": "1",
  "owner": "dclaw.super-agent-support",
  "minimum_plugin_version": "1.15.2",
  "capability_id": "business.service.installation-identity/1",
  "capability_ids": [
    "business.service.installation-identity/1",
    "agent.outbound/1",
    "agent.outbound.stream/1",
    "resource.exchange/1"
  ],
  "local_capability_gateway": {
    "owner": "dclaw-platform",
    "endpoint_path": "/api/super-agent-support/mcp/",
    "transport": "streamable-http",
    "jsonrpc_version": "2.0",
    "session_mode": "stateless",
    "mcp_session_id_required": false,
    "agent_raw_jsonrpc_allowed": false,
    "host_sequence": [
      "initialize",
      "notifications/initialized",
      "tools/list",
      "tools/call"
    ],
    "request_headers": {
      "Content-Type": "application/json",
      "Accept": "application/json, text/event-stream"
    }
  },
  "platform_injected_arguments": ["dclaw_session_token"],
  "operations": [
    {
      "client_key": "business_identity.issue",
      "tool_name": "business_service_identity_issue",
      "input_schema": "schemas/business-identity-v1/issue-request.schema.json",
      "output_schema": "schemas/business-identity-v1/issue-response.schema.json",
      "must_precede": "business_identity.outbound"
    },
    {
      "client_key": "business_identity.outbound",
      "tool_name": "business_service_outbound_request",
      "input_schema": "schemas/business-identity-v1/outbound-request.schema.json",
      "output_schema": "schemas/business-identity-v1/outbound-response.schema.json",
      "requires_binding_from": "business_identity.issue"
    },
    {
      "client_key": "agent_outbound.request",
      "capability_id": "agent.outbound/1",
      "tool_name": "agent_outbound_request",
      "input_schema": "schemas/agent-outbound-v1/request.schema.json",
      "output_schema": "schemas/agent-outbound-v1/response.schema.json",
      "credential_binding_schema": "schemas/agent-outbound-v1/credential-binding.schema.json"
    },
    {
      "client_key": "agent_outbound.stream",
      "capability_id": "agent.outbound.stream/1",
      "tool_name": "agent_outbound_stream_request",
      "input_schema": "schemas/agent-outbound-stream-v1/request.schema.json",
      "output_schema": "schemas/agent-outbound-stream-v1/response.schema.json",
      "credential_binding_schema": "schemas/agent-outbound-v1/credential-binding.schema.json"
    },
    {
      "client_key": "resource.upload.create",
      "capability_id": "resource.exchange/1",
      "tool_name": "agent_resource_upload_create",
      "input_schema": "schemas/resource-exchange-v1/upload-create.schema.json",
      "output_schema": "schemas/resource-exchange-v1/upload-create-response.schema.json"
    },
    {
      "client_key": "resource.upload.complete",
      "capability_id": "resource.exchange/1",
      "tool_name": "agent_resource_upload_complete",
      "input_schema": "schemas/resource-exchange-v1/upload-complete.schema.json",
      "output_schema": "schemas/resource-exchange-v1/response.schema.json"
    },
    {
      "client_key": "resource.read",
      "capability_id": "resource.exchange/1",
      "tool_name": "agent_resource_read",
      "input_schema": "schemas/resource-exchange-v1/read.schema.json",
      "output_schema": "schemas/resource-exchange-v1/response.schema.json"
    },
    {
      "client_key": "resource.revoke",
      "capability_id": "resource.exchange/1",
      "tool_name": "agent_resource_revoke",
      "input_schema": "schemas/resource-exchange-v1/revoke.schema.json",
      "output_schema": "schemas/resource-exchange-v1/response.schema.json"
    }
  ],
  "controlled_outbound": {
    "authorization_owner": "dclaw-platform",
    "authorization_header": "Authorization",
    "authorization_format": "Bearer <assertion>",
    "authorization_cardinality": 1,
    "agent_authorization_allowed": false,
    "proxy_forwarding": "verbatim-single-value",
    "receiver_fail_closed_on": [
      "missing",
      "duplicate",
      "combined-multi-value",
      "non-bearer",
      "empty-token"
    ],
    "ordinary_log_or_trace_allowed": false,
    "url_boundary": "registered-audience-origin-and-path-subtree",
    "redirects_allowed": false,
    "request_body": "zero-or-one-of-json_body-or-text_body"
  },
  "agent_controlled_outbound": {
    "business_owner": "sealed-super-agent",
    "credential_owner": "agent-installation",
    "credential_injection": "transport-boundary-only",
    "agent_authentication_header_allowed": false,
    "local_helper_long_term_credential_allowed": false,
    "url_boundary": "credential-domain-allowlist",
    "method_boundary": "credential-method-allowlist",
    "redirects_allowed": false,
    "maximum_request_bytes": 1048576,
    "maximum_response_bytes": 1048576,
    "request_body": "zero-or-one-of-json_body-or-text_body"
  },
  "stable_error_schema": "schemas/business-identity-v1/error.schema.json",
  "agent_outbound_error_schema": "schemas/agent-outbound-v1/error.schema.json",
  "agent_outbound_stream_error_schema": "schemas/agent-outbound-stream-v1/error.schema.json",
  "resource_exchange_error_schema": "schemas/resource-exchange-v1/error.schema.json"
}
