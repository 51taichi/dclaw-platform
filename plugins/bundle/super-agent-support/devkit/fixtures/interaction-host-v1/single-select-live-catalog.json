{
  "answer_schema": {
    "$defs": {
      "InteractionComponentType": {
        "enum": [
          "single_select",
          "multi_select",
          "question_form",
          "file_selector"
        ],
        "title": "InteractionComponentType",
        "type": "string"
      },
      "InteractionLocalFile": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Device Id",
            "type": "string"
          },
          "display_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "last_modified_ms": {
            "minimum": 0,
            "title": "Last Modified Ms",
            "type": "integer"
          },
          "local_file_ref": {
            "maxLength": 160,
            "minLength": 36,
            "pattern": "^lfr_[A-Za-z0-9_-]{32,156}$",
            "title": "Local File Ref",
            "type": "string"
          },
          "mime_type": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Mime Type",
            "type": "string"
          },
          "size_bytes": {
            "maximum": 1099511627776,
            "minimum": 0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "local_file_ref",
          "display_name",
          "mime_type",
          "size_bytes",
          "device_id",
          "last_modified_ms"
        ],
        "title": "InteractionLocalFile",
        "type": "object"
      },
      "InteractionResolvedAnswer": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Id"
          },
          "question": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Value"
          }
        },
        "required": [
          "question"
        ],
        "title": "InteractionResolvedAnswer",
        "type": "object"
      },
      "InteractionResolvedOption": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Id"
          },
          "text": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "InteractionResolvedOption",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "answers": {
        "default": [],
        "items": {
          "$ref": "#/$defs/InteractionResolvedAnswer"
        },
        "title": "Answers",
        "type": "array"
      },
      "component_type": {
        "$ref": "#/$defs/InteractionComponentType"
      },
      "files": {
        "default": [],
        "items": {
          "$ref": "#/$defs/InteractionLocalFile"
        },
        "title": "Files",
        "type": "array"
      },
      "interaction_id": {
        "minLength": 1,
        "title": "Interaction Id",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "selected": {
        "default": [],
        "items": {
          "$ref": "#/$defs/InteractionResolvedOption"
        },
        "title": "Selected",
        "type": "array"
      },
      "submitted_at": {
        "format": "date-time",
        "title": "Submitted At",
        "type": "string"
      },
      "supplement": {
        "anyOf": [
          {
            "maxLength": 5000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Supplement"
      }
    },
    "required": [
      "interaction_id",
      "component_type",
      "submitted_at"
    ],
    "title": "InteractionAnswer",
    "type": "object"
  },
  "catalog_version": "1",
  "components": [
    {
      "component_type": "single_select",
      "contract_version": "1",
      "create_example": {
        "card": {
          "layout": "auto",
          "options": [
            {
              "id": "option-a",
              "recommended": true,
              "text": "选项甲"
            },
            {
              "text": "选项乙"
            }
          ],
          "supplement": {
            "enabled": true,
            "required": false
          },
          "title": "请选择最贴近的一项"
        },
        "component_type": "single_select",
        "input_policy": "card_only",
        "interaction_revision": 1,
        "task_key": "customer-choice"
      },
      "defaults": {
        "input_policy": "card_only",
        "layout": "auto",
        "supplement.enabled": false,
        "supplement.required": false
      },
      "do_not_use_when": [
        "需要客户自由描述事实",
        "允许同时选择多个选项"
      ],
      "error_examples": [
        {
          "error": "INVALID_INTERACTION_REQUEST",
          "issues": [
            {
              "code": "INVALID_VALUE",
              "field": "card.options"
            }
          ],
          "retryable": true
        }
      ],
      "schema": {
        "$defs": {
          "InteractionLayout": {
            "enum": [
              "auto",
              "list",
              "grid"
            ],
            "title": "InteractionLayout",
            "type": "string"
          },
          "InteractionOption": {
            "additionalProperties": false,
            "properties": {
              "action_url": {
                "anyOf": [
                  {
                    "maxLength": 2048,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Action Url"
              },
              "auto_submit_on_desktop": {
                "default": false,
                "title": "Auto Submit On Desktop",
                "type": "boolean"
              },
              "default_selected": {
                "default": false,
                "title": "Default Selected",
                "type": "boolean"
              },
              "description": {
                "anyOf": [
                  {
                    "maxLength": 1000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Description"
              },
              "id": {
                "anyOf": [
                  {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Id"
              },
              "recommended": {
                "default": false,
                "title": "Recommended",
                "type": "boolean"
              },
              "text": {
                "maxLength": 500,
                "minLength": 1,
                "title": "Text",
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "title": "InteractionOption",
            "type": "object"
          },
          "InteractionSupplement": {
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "default": false,
                "title": "Enabled",
                "type": "boolean"
              },
              "answer_mode": {
                "default": "note",
                "enum": [
                  "note",
                  "choice"
                ],
                "title": "Answer Mode",
                "type": "string"
              },
              "label": {
                "default": "补充信息",
                "maxLength": 80,
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "max_length": {
                "default": 2000,
                "maximum": 5000,
                "minimum": 1,
                "title": "Max Length",
                "type": "integer"
              },
              "placeholder": {
                "default": "如有其他情况可以补充",
                "maxLength": 200,
                "minLength": 1,
                "title": "Placeholder",
                "type": "string"
              },
              "required": {
                "default": false,
                "title": "Required",
                "type": "boolean"
              }
            },
            "title": "InteractionSupplement",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "layout": {
            "$ref": "#/$defs/InteractionLayout",
            "default": "auto"
          },
          "options": {
            "items": {
              "$ref": "#/$defs/InteractionOption"
            },
            "maxItems": 20,
            "minItems": 2,
            "title": "Options",
            "type": "array"
          },
          "supplement": {
            "$ref": "#/$defs/InteractionSupplement"
          },
          "title": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "options"
        ],
        "title": "SingleSelectCard",
        "type": "object"
      },
      "summary": "客户必须且只能从预设选项中选择一项。",
      "use_when": [
        "当前问题具有两个及以上完整预设选项",
        "客户只需要选择一个最贴近项"
      ]
    }
  ]
}
