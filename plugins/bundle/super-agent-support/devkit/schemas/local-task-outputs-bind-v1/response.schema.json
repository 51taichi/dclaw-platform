{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local.task.outputs.bind/1 response",
  "type": "object",
  "required": ["contract", "status"],
  "properties": {
    "contract": {"const": "local.task.outputs.bind/1"},
    "status": {"enum": ["bound", "not_found", "source_not_ready", "invalid_request", "rejected", "unavailable"]},
    "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.]{0,63}$"},
    "expires_at": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "required": ["slot", "order", "file"],
        "properties": {
          "slot": {"type": "string"},
          "order": {"type": "integer", "minimum": 0},
          "file": {
            "type": "object",
            "required": ["local_file_ref", "display_name", "mime_type", "size_bytes", "device_id", "last_modified_ms"],
            "properties": {
              "local_file_ref": {"type": "string", "pattern": "^lfr_[A-Za-z0-9_-]{32,156}$"},
              "display_name": {"type": "string", "minLength": 1},
              "mime_type": {"type": "string", "minLength": 1},
              "size_bytes": {"type": "integer", "minimum": 0},
              "device_id": {"type": "string", "minLength": 1},
              "last_modified_ms": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "bound"}}}, "then": {"required": ["expires_at", "files"]}},
    {"if": {"properties": {"status": {"const": "rejected"}}}, "then": {"required": ["error_code"]}}
  ],
  "additionalProperties": false
}
