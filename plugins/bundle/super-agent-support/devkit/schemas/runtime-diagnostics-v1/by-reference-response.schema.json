{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "developer.runtime.diagnostics.by-reference/1 response",
  "oneOf": [
    {
      "type": "object",
      "required": ["contract", "status", "retention_days"],
      "properties": {
        "contract": {"const": "developer.runtime.diagnostics.by-reference/1"},
        "status": {"const": "no_record"},
        "retention_days": {"const": 30}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["contract", "status", "retention_days", "task_id", "invocation_id", "installation_id", "release_id", "started_at", "failed_at", "first_failure", "first_failure_source", "error_code", "transaction_status", "stages"],
      "properties": {
        "contract": {"const": "developer.runtime.diagnostics.by-reference/1"},
        "status": {"const": "found"},
        "retention_days": {"const": 30},
        "task_id": {"type": "string"},
        "invocation_id": {"type": "string"},
        "installation_id": {"type": "string"},
        "release_id": {"type": "string"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "failed_at": {"type": "string", "format": "date-time"},
        "first_failure": {"type": "object", "required": ["phase", "category", "attempt"], "properties": {"phase": {"type": ["string", "null"]}, "category": {"type": ["string", "null"]}, "attempt": {"type": ["integer", "null"]}}, "additionalProperties": false},
        "first_failure_source": {"enum": ["agent_trace", "host_stage", "platform_preflight", "not_recorded"]},
        "error_code": {"type": ["string", "null"]},
        "transaction_status": {"const": "discarded"},
        "stages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["event", "source", "at", "duration_ms"],
            "properties": {
              "event": {"type": "string"},
              "source": {"enum": ["host", "agent"]},
              "at": {"type": "string", "format": "date-time"},
              "duration_ms": {"type": ["integer", "null"], "minimum": 0},
              "call_number": {"type": "integer", "minimum": 1},
              "has_text": {"type": "boolean"},
              "text_length": {"type": "integer", "minimum": 0},
              "complete_json_object": {"type": "boolean"},
              "execution_mode": {"type": "string"},
              "response_format": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
