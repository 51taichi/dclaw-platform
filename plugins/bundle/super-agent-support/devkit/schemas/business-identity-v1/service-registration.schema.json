{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/business-identity-v1/service-registration.schema.json",
  "title": "Business identity service registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["developer_id", "service_id", "audience", "allowed_domains", "allowed_scopes"],
  "properties": {
    "developer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "service_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "audience": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "allowed_domains": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "format": "hostname", "maxLength": 253}},
    "allowed_scopes": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}}
  }
}
