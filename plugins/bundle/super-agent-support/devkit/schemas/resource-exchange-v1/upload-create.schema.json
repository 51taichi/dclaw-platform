{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/resource-exchange-v1/upload-create.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["mime_type", "max_size_bytes", "purpose"],
  "properties": {"mime_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]{0,63}/[a-z0-9][a-z0-9.+-]{0,127}$"}, "max_size_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}, "purpose": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"}, "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 3600, "default": 900}}
}
