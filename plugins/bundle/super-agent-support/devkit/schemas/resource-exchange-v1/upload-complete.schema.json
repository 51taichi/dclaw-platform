{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/resource-exchange-v1/upload-complete.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_ref", "size_bytes", "sha256"],
  "properties": {"resource_ref": {"type": "string", "pattern": "^res_[0-9a-f]{32}$"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
