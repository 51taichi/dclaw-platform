{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/agent-outbound-stream-v1/request.schema.json",
  "title": "Restricted Agent streaming outbound request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "url", "credential_scope", "output_mime_type", "purpose"],
  "properties": {
    "protocol": {"enum": ["https", "wss"]},
    "url": {"type": "string", "format": "uri", "maxLength": 4096},
    "credential_ref": {"type": "string", "pattern": "^cred_[0-9a-f]{32}$"},
    "credential_slot": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "credential_scope": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "method": {"enum": ["GET", "POST", "PUT", "PATCH"], "default": "GET"},
    "headers": {"type": "object", "maxProperties": 8, "additionalProperties": {"type": "string", "maxLength": 2048}},
    "json_body": {},
    "text_body": {"type": "string", "maxLength": 1048576},
    "send_frames": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "data"], "properties": {"kind": {"enum": ["text", "json", "binary_base64"]}, "data": {}}}},
    "completion_text": {"type": "string", "maxLength": 256},
    "binary_filter_contains": {"type": "string", "maxLength": 256},
    "binary_strip_through": {"type": "string", "maxLength": 256},
    "output_mime_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]{0,63}/[a-z0-9][a-z0-9.+-]{0,127}$"},
    "purpose": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300, "default": 60},
    "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432, "default": 33554432}
  },
  "allOf": [
    {"oneOf": [{"required": ["credential_ref"]}, {"required": ["credential_slot"]}]},
    {"not": {"required": ["json_body", "text_body"]}},
    {"if": {"properties": {"protocol": {"const": "wss"}}, "required": ["protocol"]}, "then": {"required": ["send_frames"], "properties": {"method": {"const": "GET"}}}}
  ]
}
