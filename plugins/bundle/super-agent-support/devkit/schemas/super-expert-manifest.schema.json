{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/contracts/super-expert-manifest/v3",
  "title": "DClaw Super Expert manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","agent_id","name","version","agent_type","scope","entrypoint","package_type","orchestration","platform_contract_versions","capabilities","capability_digest","signer_id"],
  "properties": {
    "schema_version": {"const": 3},
    "agent_id": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,128}$"},
    "name": {"type":"string","minLength":1,"maxLength":200},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "agent_type": {"const":"sealed"},
    "scope": {"const":"global"},
    "entrypoint": {"type":"string","pattern":"^agent/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"},
    "package_type": {"const":"super_expert"},
    "orchestration": {
      "type":"object","additionalProperties":false,
      "required":["capability_id","contract_version","entrypoint","required_host_capabilities"],
      "properties": {
        "capability_id":{"const":"workspace.turn.orchestrate/1"},
        "contract_version":{"const":"1"},
        "entrypoint":{"type":"string","pattern":"^[A-Za-z0-9_./-]+\\.py:[A-Za-z_][A-Za-z0-9_]*$"},
        "required_host_capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string"}}
      }
    },
    "platform_contract_versions":{"type":"object","additionalProperties":{"type":"string"}},
    "capabilities":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["capability_id","contract_version"],"properties":{"capability_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]*(?:/[1-9][0-9]*)?$"},"contract_version":{"type":"string","pattern":"^[1-9][0-9]{0,7}$"}}}},
    "capability_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signer_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "content_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "public_metadata":{"type":"object","additionalProperties":false,"properties":{"description":{"type":"string","maxLength":2000},"icon":{"type":["string","null"]},"tags":{"type":"array","maxItems":50,"items":{"type":"string"}}}}
  }
}
