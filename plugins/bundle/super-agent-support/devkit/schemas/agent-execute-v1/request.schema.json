{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/agent-execute-v1/request.schema.json",
  "title": "agent.execute request",
  "oneOf": [
    {
      "type": "object",
      "required": ["messages"],
      "properties": {
        "messages": {"$ref": "#/$defs/messages"},
        "response_format": {"const": "json_object"},
        "recover_empty_reply": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["messages", "execution_mode", "instruction"],
      "properties": {
        "messages": {"$ref": "#/$defs/messages"},
        "execution_mode": {"const": "agent_loop"},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 16000},
        "require_interaction": {"type": "boolean", "default": false},
        "public_stream": {"type": "boolean", "default": false},
        "recover_empty_reply": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"enum": ["system", "user", "assistant", "tool"]},
          "content": {}
        },
        "additionalProperties": true
      }
    }
  }
}
