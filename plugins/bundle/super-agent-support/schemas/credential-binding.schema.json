{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/plugins/super-agent-support/v1/credential-binding.schema.json",
  "title": "DClaw credential broker binding request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "secret", "scopes", "installation_ids"],
  "properties": {
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "secret": {"type": "object", "minProperties": 1},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"}},
    "agent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "installation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  }
}
