{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/plugins/super-agent-support/v1/public-component-descriptor.schema.json",
  "title": "DClaw signed public Component descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptor_version", "component_id", "display_name", "platform", "component_version", "status", "provides", "dependencies", "artifact", "exports", "path_entries", "environment_paths", "sbom", "license", "cache_key", "rollback_version", "notes"],
  "properties": {
    "descriptor_version": {"const": "1"},
    "component_id": {"$ref": "#/$defs/ComponentId"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "platform": {"enum": ["windows-x64", "windows-arm64", "macos-arm64", "macos-x64"]},
    "component_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
    "status": {"enum": ["available", "reserved", "disabled"]},
    "provides": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"}},
    "dependencies": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "version"], "properties": {"component_id": {"$ref": "#/$defs/ComponentId"}, "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"}}}},
    "artifact": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["url", "sha256", "size_bytes", "archive_format"], "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://"}, "sha256": {"$ref": "#/$defs/Sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648}, "unpacked_size_bytes": {"type": "integer", "minimum": 1, "maximum": 8589934592}, "archive_format": {"const": "zip"}}}]},
    "exports": {"type": "object", "maxProperties": 64, "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"}, "additionalProperties": {"$ref": "#/$defs/RelativePath"}},
    "path_entries": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/RelativePath"}},
    "environment_paths": {"type": "object", "additionalProperties": false, "properties": {"PYTHONHOME": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/RelativePath"}}, "PYTHONPATH": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/RelativePath"}}}},
    "sbom": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Evidence"}]},
    "license": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["spdx", "evidence_url", "evidence_sha256"], "properties": {"spdx": {"type": "string", "minLength": 1, "maxLength": 128}, "evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "evidence_sha256": {"$ref": "#/$defs/Sha256"}}}]},
    "cache_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "rollback_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "notes": {"type": "string", "maxLength": 1024}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "available"}}}, "then": {"properties": {"artifact": {"type": "object"}, "sbom": {"type": "object"}, "license": {"type": "object"}}}},
    {"if": {"properties": {"status": {"enum": ["reserved", "disabled"]}}}, "then": {"properties": {"artifact": {"type": "null"}}}}
  ],
  "$defs": {
    "ComponentId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "RelativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$", "maxLength": 256},
    "Evidence": {"type": "object", "additionalProperties": false, "required": ["url", "sha256"], "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://"}, "sha256": {"$ref": "#/$defs/Sha256"}}}
  }
}
