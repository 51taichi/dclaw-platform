{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/plugins/super-agent-support/v2/device-message.schema.json",
  "title": "DClaw local helper to platform message v2",
  "oneOf": [
    {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"heartbeat"}}},
    {"type":"object","additionalProperties":false,"required":["type","capabilities"],"properties":{"type":{"const":"capabilities.report"},"capabilities":{"type":"array","items":{"$ref":"#/$defs/Capability"}}}},
    {"type":"object","additionalProperties":false,"required":["type","task_id","sequence","event_type","payload"],"properties":{"type":{"const":"task.event"},"task_id":{"type":"string","pattern":"^[a-f0-9]{32}$"},"sequence":{"type":"integer","minimum":1},"event_type":{"enum":["started","progress","checkpoint","completed","failed","cancelled"]},"payload":{"type":"object"}}},
    {"type":"object","additionalProperties":false,"required":["type","request_id","status","files"],"properties":{"type":{"const":"file.select.result"},"request_id":{"$ref":"#/$defs/RequestId"},"status":{"enum":["selected","cancelled","error"]},"files":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/LocalFile"}},"error_code":{"$ref":"#/$defs/FileError"}}},
    {"type":"object","additionalProperties":false,"required":["type","request_id","status"],"properties":{"type":{"const":"file.upload.result"},"request_id":{"$ref":"#/$defs/RequestId"},"status":{"enum":["uploaded","error"]},"size_bytes":{"type":"integer","minimum":0},"error_code":{"$ref":"#/$defs/FileError"}}},
    {"type":"object","additionalProperties":false,"required":["type","request_id","artifacts"],"properties":{"type":{"const":"managed_artifacts.result"},"request_id":{"$ref":"#/$defs/RequestId"},"artifacts":{"type":"array","items":{"$ref":"#/$defs/ManagedArtifact"}}}},
    {"type":"object","additionalProperties":false,"required":["type","request_id","status","artifact_id","action"],"properties":{"type":{"const":"managed_artifact.result"},"request_id":{"$ref":"#/$defs/RequestId"},"status":{"enum":["ok","error"]},"artifact_id":{"type":"string","pattern":"^artifact_[A-Za-z0-9_-]{32,156}$"},"action":{"enum":["preview","select","open_directory","delete"]},"file":{"$ref":"#/$defs/LocalFile"},"error_code":{"$ref":"#/$defs/FileError"}}}
  ],
  "$defs": {
    "RequestId":{"type":"string","pattern":"^[a-f0-9]{32}$"},
    "Capability":{"type":"object","additionalProperties":false,"required":["capability_id","version","package_id","package_version"],"properties":{"capability_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"},"version":{"type":"string","minLength":1,"maxLength":32},"package_id":{"type":"string","minLength":1,"maxLength":128},"package_version":{"type":"string","minLength":1,"maxLength":64}}},
    "LocalFile":{"type":"object","additionalProperties":false,"required":["local_file_ref","display_name","mime_type","size_bytes","device_id","last_modified_ms"],"properties":{"local_file_ref":{"type":"string","pattern":"^lfr_[A-Za-z0-9_-]{32,156}$"},"display_name":{"type":"string","minLength":1,"maxLength":255,"pattern":"^[^/\\\\\\u0000]+$"},"mime_type":{"type":"string","minLength":1,"maxLength":255},"size_bytes":{"type":"integer","minimum":0,"maximum":1099511627776},"device_id":{"type":"string","minLength":1,"maxLength":128},"last_modified_ms":{"type":"integer","minimum":0}}},
    "ManagedArtifact":{"type":"object","additionalProperties":false,"required":["artifact_id","task_id","display_name","mime_type","size_bytes","created_at"],"properties":{"artifact_id":{"type":"string","pattern":"^artifact_[A-Za-z0-9_-]{32,156}$"},"task_id":{"type":"string","minLength":1,"maxLength":128},"display_name":{"type":"string","minLength":1,"maxLength":255,"pattern":"^[^/\\\\\\u0000]+$"},"mime_type":{"type":"string","minLength":1,"maxLength":255},"size_bytes":{"type":"integer","minimum":0},"created_at":{"type":"integer","minimum":0}}},
    "FileError":{"enum":["FILE_SELECTOR.UNSUPPORTED","FILE_SELECTOR.PERMISSION_DENIED","FILE_SELECTOR.FILE_TOO_LARGE","FILE_SELECTOR.FILE_COUNT_EXCEEDED","LOCAL_FILE_REF.EXPIRED","LOCAL_FILE_REF.REVOKED","LOCAL_FILE_REF.WRONG_DEVICE","LOCAL_FILE_REF.SCOPE_MISMATCH","LOCAL_FILE_REF.FILE_CHANGED","LOCAL_FILE_REF.FILE_MISSING","LOCAL_FILE_REF.RESOLVE_FAILED"]}
  }
}
