ARG DCLAW_BASE_IMAGE
FROM ${DCLAW_BASE_IMAGE}

WORKDIR /app

# The base production image already contains the separately built console,
# Chromium, system packages, and the Python environment.  A server-only patch
# replaces the tracked backend source and reinstalls this repository package
# without rebuilding or changing those runtime assets.
COPY pyproject.toml uv.lock setup.py README.md ./
COPY scripts/db ./scripts/db
COPY deploy/pricing ./deploy/pricing
COPY scripts/perf ./scripts/perf
COPY src ./src

RUN /bin/uv pip install \
      --python /app/venv/bin/python \
      --no-cache-dir \
      --no-deps \
      . \
    && rm -rf ./build
