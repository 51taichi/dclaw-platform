# Non-secret production defaults. adopt.sh writes the real protected
# production.env from the current container without printing its values.
QWENPAW_DATABASE_BACKEND=postgres
QWENPAW_RUNTIME_BACKEND=redis
QWENPAW_REDIS_URL=redis://dclaw-redis:6379/0
QWENPAW_AUTH_ENABLED=true
QWENPAW_PUBLIC_BASE_URL=https://dclaw.deepmega.cn
AIGC_STUDIO_PUBLIC_BASE_URL=https://dclaw.deepmega.cn
PUBLIC_BASE_URL=
QWENPAW_DISABLED_CHANNELS=imessage
QWENPAW_ENABLED_CHANNELS=
QWENPAW_PORT=8088
