# Non-secret production defaults. adopt.sh writes the real protected
# production.env from the current container without printing its values.
QWENPAW_DATABASE_BACKEND=postgres
QWENPAW_RUNTIME_BACKEND=redis
QWENPAW_REDIS_URL=redis://dclaw-redis:6379/0
QWENPAW_AUTH_ENABLED=true
QWENPAW_PUBLIC_BASE_URL=https://dclaw.deepmega.cn
AIGC_STUDIO_PUBLIC_BASE_URL=https://dclaw.deepmega.cn
# Maximum time allowed to send one object to OSS; large generated videos need
# substantially more than the previous fixed 60-second limit.
DCLAW_OSS_WRITE_TIMEOUT_SECONDS=600
DCLAW_OPEN_API_DEFAULT_OUTPUT_TOKENS=2048
DCLAW_SUPER_EXPERT_DEFAULT_OUTPUT_TOKENS=4096
# OpenAPI admission control. These limits apply only to published OpenAPI
# targets; console and ordinary task limits keep their existing defaults.
DCLAW_OPEN_API_MAX_RUNNING_TASKS_GLOBAL=100
DCLAW_OPEN_API_MAX_RUNNING_TASKS_PER_PUBLICATION=30
DCLAW_OPEN_API_MAX_RUNNING_TASKS_PER_API_KEY=20
DCLAW_OPEN_API_MAX_WAITING_PER_PUBLICATION=200
DCLAW_OPEN_API_MAX_WAITING_PER_API_KEY=100
DCLAW_OPEN_API_WAIT_TIMEOUT_SECONDS=60
DCLAW_OPEN_API_WAIT_POLL_SECONDS=0.25
DCLAW_OPEN_API_RETRY_AFTER_SECONDS=5
# Capacity experiment: allow OpenAPI traffic to use a larger share of the
# platform while retaining the existing per-key and per-publication controls.
QWENPAW_MAX_RUNNING_TASKS=150
QWENPAW_LLM_MAX_CONCURRENT=999
PUBLIC_BASE_URL=
QWENPAW_DISABLED_CHANNELS=imessage
QWENPAW_ENABLED_CHANNELS=
QWENPAW_PORT=8088
DCLAW_DESKTOP_BRAND_ID=dclaw
DCLAW_DESKTOP_LATEST_PATH=/opt/dclaw-updates/latest.json
