DCLAW_IMAGE=dclaw-local:current
DCLAW_BIND_HOST=0.0.0.0
DCLAW_HOST_PORT=18088
# Leave blank so browser requests use their current localhost or LAN origin.
DCLAW_PUBLIC_BASE_URL=
DCLAW_ADMIN_USERNAME=admin
DCLAW_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
DCLAW_POSTGRES_PASSWORD=replace-with-at-least-16-random-characters
QWENPAW_AUTH_ENABLED=true
QWENPAW_DATABASE_BACKEND=postgres
QWENPAW_RUNTIME_BACKEND=redis
QWENPAW_KNOWLEDGE_WORKERS=2
DCLAW_OPEN_API_DEFAULT_OUTPUT_TOKENS=2048
DCLAW_SUPER_EXPERT_DEFAULT_OUTPUT_TOKENS=4096
DCLAW_OPEN_API_MAX_RUNNING_TASKS_GLOBAL=100
DCLAW_OPEN_API_MAX_RUNNING_TASKS_PER_PUBLICATION=60
DCLAW_OPEN_API_MAX_RUNNING_TASKS_PER_API_KEY=20
DCLAW_OPEN_API_MAX_WAITING_PER_PUBLICATION=200
DCLAW_OPEN_API_MAX_WAITING_PER_API_KEY=100
DCLAW_OPEN_API_WAIT_TIMEOUT_SECONDS=120
QWENPAW_MAX_RUNNING_TASKS=150
QWENPAW_TASK_OWNER_TTL_SECONDS=180
QWENPAW_LLM_MAX_CONCURRENT=999
VOLCANO_API_KEY=
MXAPI_API_KEY=
# Credit alert SMS remains disabled until Aliyun credentials, signature, and
# template are ready. Set DCLAW_SMS_PROVIDER=aliyun to enable new crossings.
DCLAW_SMS_PROVIDER=disabled
DCLAW_ALIYUN_SMS_ACCESS_KEY_ID=
DCLAW_ALIYUN_SMS_ACCESS_KEY_SECRET=
DCLAW_LOCAL_EXECUTION_SESSION_SECRET=local-example-local-execution-session-secret-000000
DCLAW_ALIYUN_SMS_SIGN_NAME=湖南星芒物联科技
DCLAW_ALIYUN_SMS_TEMPLATE_CODE=SMS_512581202
