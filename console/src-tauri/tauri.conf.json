{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DClaw",
  "version": "2.6.21",
  "identifier": "com.dclaw.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node scripts/desktop-before-build.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "AI超级流量专家",
        "label": "main",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible",
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "shortDescription": "AI 智能工作台",
    "longDescription": "DClaw 是一个本地优先的 AI 桌面智能工作台，支持桌面自动化、智能文档处理和多模型协作。"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://dclaw.deepmega.cn/latest.json"
      ],
      "dialog": false,
      "pubkey": ""
    }
  }
}
