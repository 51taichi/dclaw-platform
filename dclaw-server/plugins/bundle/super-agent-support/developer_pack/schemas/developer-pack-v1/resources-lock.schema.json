{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/developer-pack-v1/resources-lock.schema.json",
  "title": "DClaw Local Capability Resource Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "release_ready",
    "allowed_domains",
    "resources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "release-ready"},
    "release_ready": {"const": true},
    "allowed_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "resources": {
      "type": "array",
      "items": {"$ref": "#/$defs/resource"}
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "version",
        "url",
        "size_bytes",
        "sha256",
        "sbom_url",
        "sbom_sha256",
        "license_spdx",
        "license_evidence_url",
        "license_evidence_sha256",
        "cache_key",
        "rollback_version"
      ],
      "dependentRequired": {
        "unpacked_size_bytes": ["target_path"],
        "target_path": ["unpacked_size_bytes"]
      },
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "unpacked_size_bytes": {"type": "integer", "minimum": 1},
        "target_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sbom_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sbom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license_spdx": {"type": "string", "minLength": 1},
        "license_evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "license_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cache_key": {"type": "string", "minLength": 1},
        "rollback_version": {"type": "string", "minLength": 1},
        "status": {"enum": ["ready", "release-ready"]},
        "distribution_status": {"enum": ["ready", "release-ready"]}
      }
    }
  }
}
