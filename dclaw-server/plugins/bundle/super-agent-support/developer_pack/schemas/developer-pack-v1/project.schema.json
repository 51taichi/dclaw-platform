{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/developer-pack-v1/project.schema.json",
  "title": "DClaw Super Agent developer project",
  "type": "object",
  "required": ["schema_version", "agent_id", "developer_pack_version", "standard", "devkit_version", "local_helper", "declared_platform_capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "developer_pack_version": {"type": "string"},
    "standard": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "dclaw.super-agent-development"},
        "version": {"type": "string"}
      }
    },
    "devkit_version": {"type": "string"},
    "local_helper": {"enum": ["none", "optional", "required"]},
    "declared_platform_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"enum": ["unittest", "pytest"]},
        "python": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "arguments": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
