{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/plugins/super-agent-support/v1/capability-descriptor.schema.json",
  "title": "DClaw signed local capability package descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_version",
    "contract_version",
    "capability_id",
    "package_id",
    "package_version",
    "implementation_status",
    "min_runner_version",
    "artifact",
    "entrypoint",
    "schemas",
    "operating_systems",
    "permissions",
    "limits",
    "semantics"
  ],
  "properties": {
    "descriptor_version": {"const": "1"},
    "contract_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "capability_id": {"$ref": "#/$defs/CapabilityId"},
    "package_id": {"$ref": "#/$defs/CapabilityId"},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "implementation_status": {"enum": ["release"]},
    "min_runner_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size_bytes"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}
      }
    },
    "entrypoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "arguments"],
          "properties": {
            "executable": {"type": "string", "minLength": 1, "maxLength": 256},
            "arguments": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 512}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["component_id", "export", "arguments"],
          "properties": {
            "component_id": {"$ref": "#/$defs/ComponentId"},
            "export": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "arguments": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 512}}
          }
        }
      ]
    },
    "public_components": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "version"],
        "properties": {
          "component_id": {"$ref": "#/$defs/ComponentId"},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"}
        }
      }
    },
    "component_exports": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["environment_variable", "component_id", "export"],
        "properties": {
          "environment_variable": {
            "type": "string",
            "pattern": "^DCLAW_COMPONENT_[A-Z][A-Z0-9_]{0,47}$"
          },
          "component_id": {"$ref": "#/$defs/ComponentId"},
          "export": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "result", "checkpoint"],
      "properties": {
        "input": {"$ref": "#/$defs/SchemaFile"},
        "result": {"$ref": "#/$defs/SchemaFile"},
        "checkpoint": {"$ref": "#/$defs/SchemaFile"}
      }
    },
    "operating_systems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["windows-x64", "windows-arm64"]}
    },
    "credential_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"}
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "network_domains", "processes", "browser"],
      "properties": {
        "workspace": {"const": "task-only"},
        "network_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
        "processes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}},
        "browser": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_runtime_seconds", "max_memory_mib", "max_disk_mib", "max_concurrency", "max_output_bytes"],
      "properties": {
        "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_memory_mib": {"type": "integer", "minimum": 64, "maximum": 32768},
        "max_disk_mib": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776}
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency", "cancellation", "recovery", "cleanup"],
      "properties": {
        "idempotency": {"type": "string", "minLength": 1, "maxLength": 1024},
        "cancellation": {"type": "string", "minLength": 1, "maxLength": 1024},
        "recovery": {"type": "string", "minLength": 1, "maxLength": 1024},
        "cleanup": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  },
  "$defs": {
    "ComponentId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "CapabilityId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$", "maxLength": 128},
    "SchemaFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "document"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.json$", "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "document": {"type": "object"}
      }
    }
  }
}
