    "RuntimePrepare":{"type":"object","additionalProperties":false,"required":["type","protocol_version","public_components"],"properties":{"type":{"const":"runtime.prepare"},"protocol_version":{"enum":["1","2"]},"public_components":{"type":"array","maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["descriptor","signer_id","signature","signer_public_key","canonical_payload"],"properties":{"descriptor":{"$ref":"public-component-descriptor.schema.json"},"signer_id":{"type":"string","minLength":1,"maxLength":128},"signature":{"type":"string","minLength":1,"maxLength":1024},"signer_public_key":{"type":"string","minLength":1,"maxLength":2048},"canonical_payload":{"type":"string","minLength":1,"maxLength":131072}}}},"capability_package":{"type":"object","additionalProperties":false,"required":["descriptor","signer_id","signature"],"properties":{"descriptor":{"$ref":"capability-descriptor.schema.json"},"signer_id":{"type":"string","minLength":1,"maxLength":128},"signature":{"type":"string","minLength":1,"maxLength":1024}}},"built_in_capability":{"type":"object","additionalProperties":false,"required":["capability_id","package_version"],"properties":{"capability_id":{"const":"dclaw.ffmpeg.task.plan"},"package_version":{"const":"0.1.0"}}}},"oneOf":[{"required":["capability_package"]},{"required":["built_in_capability"]}]},
