  "properties": {
    "source_task_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "slots": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}
    }
  },
  "additionalProperties": false
}
