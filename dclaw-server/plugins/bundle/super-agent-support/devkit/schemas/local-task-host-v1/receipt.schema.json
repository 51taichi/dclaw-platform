{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local.task.receipt/1 response",
  "oneOf": [
    {
      "type": "object",
      "required": ["contract", "status"],
      "properties": {
        "contract": {"const": "local.task.receipt/1"},
        "status": {"enum": ["not_found", "unavailable"]}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["contract", "status", "error_code"],
      "properties": {
        "contract": {"const": "local.task.receipt/1"},
        "status": {"const": "rejected"},
        "error_code": {"type": "string"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["contract", "task_id", "capability_id", "idempotency_key", "status", "error_code", "artifact_ids", "result_sha256"],
      "properties": {
        "contract": {"const": "local.task.receipt/1"},
        "task_id": {"type": "string"},
        "capability_id": {"type": "string"},
        "idempotency_key": {"type": ["string", "null"]},
        "status": {"enum": ["queued", "running", "awaiting_input", "cancelling", "succeeded", "failed", "cancelled"]},
        "error_code": {"type": ["string", "null"]},
        "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^artifact_[A-Za-z0-9_-]{32,156}$"}},
        "result_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  ]
}
