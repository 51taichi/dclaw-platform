{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/business-identity-v1/issue-request.schema.json",
  "title": "Business service installation identity issue request",
  "type": "object",
  "additionalProperties": false,
  "required": ["service_id", "audience", "scopes", "idempotency_key"],
  "properties": {
    "service_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "audience": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "scopes": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}},
    "ttl_seconds": {"type": "integer", "minimum": 30, "maximum": 300, "default": 120},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128}
  }
}
