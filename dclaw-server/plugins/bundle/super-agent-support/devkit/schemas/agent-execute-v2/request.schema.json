{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/agent-execute-v2/request.schema.json",
  "title": "agent.execute v2 request",
  "oneOf": [
    {
      "type": "object",
      "required": ["messages"],
      "properties": {
        "messages": {"$ref": "#/$defs/messages"},
        "execution_mode": {"const": "agent_loop"},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 16000},
        "require_interaction": {"type": "boolean"},
        "interaction_tool_access": {"enum": ["legacy", "disabled"]},
        "public_stream": {"type": "boolean"},
        "recover_empty_reply": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["messages", "execution_mode"],
      "properties": {
        "messages": {"$ref": "#/$defs/messages"},
        "execution_mode": {"const": "candidate"},
        "response_format": {"const": "json_object"},
        "recover_empty_reply": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"enum": ["system", "user", "assistant", "tool"]},
          "content": {}
        },
        "additionalProperties": true
      }
    }
  }
}
