{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/runtime-fail-v1/request.schema.json",
  "type": "object",
  "required": ["invocation_id", "error_code"],
  "properties": {
    "invocation_id": {"type": "string", "minLength": 1},
    "error_code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:orchestration_error|orchestration_timeout|runtime_failed|unauthorized_capability|invalid_completion|[A-Z][A-Z0-9_]*(?:\\.[A-Z][A-Z0-9_]*)*)$"
    },
    "diagnostic_ref": {"type": ["string", "null"], "maxLength": 200}
  },
  "additionalProperties": false
}
