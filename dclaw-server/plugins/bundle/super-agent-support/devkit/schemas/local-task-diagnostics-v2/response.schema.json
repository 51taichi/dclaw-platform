{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "developer.local-task.diagnostics.read/2 response",
  "type": "object",
  "required": ["contract", "status", "retention_days", "tasks"],
  "properties": {
    "contract": {"const": "developer.local-task.diagnostics.read/2"},
    "status": {"enum": ["found", "no_record"]},
    "retention_days": {"const": 30},
    "tasks": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/task"}}
  },
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "required": ["task_id", "invocation_id", "release_id", "installation_id", "capability", "host_accepted", "host_dispatched", "helper_received", "helper_version", "helper_version_evidence", "device_online_now", "task_status", "first_failure_phase", "phase_evidence", "error_code", "exception_category", "category_evidence", "failure_evidence", "responsibility", "recovery_action", "accepted_at", "helper_started_at", "updated_at"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "invocation_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "release_id": {"type": "string"},
        "installation_id": {"type": "string"},
        "capability": {"type": "string", "minLength": 1, "maxLength": 128},
        "host_accepted": {"const": true},
        "host_dispatched": {"type": ["boolean", "null"]},
        "helper_received": {"type": ["boolean", "null"]},
        "helper_version": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+){1,3}$"},
        "helper_version_evidence": {"enum": ["recorded", "historical_detail_not_recorded"]},
        "device_online_now": {"type": ["boolean", "null"]},
        "task_status": {"enum": ["queued", "running", "awaiting_input", "cancelling", "succeeded", "failed", "cancelled"]},
        "first_failure_phase": {"enum": [null, "helper_receive", "download_prepare", "download_transfer", "manifest_write", "completion_event", "file_binding", "input_write", "capability_prepare", "capability_execute", "resource_limit", "result_registration", "host_dispatch"]},
        "phase_evidence": {"enum": ["recorded", "historical_detail_not_recorded", "not_applicable"]},
        "error_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_.]{0,63}$"},
        "exception_category": {"enum": [null, "json_lifetime", "invalid_input", "network_failure", "asset_validation", "file_io", "helper_internal", "file_binding", "capability_execution", "resource_limit"]},
        "category_evidence": {"enum": ["recorded", "historical_detail_not_recorded", "not_applicable"]},
        "failure_evidence": {"enum": ["recorded", "historical_detail_not_recorded", "not_applicable"]},
        "responsibility": {"enum": ["developer", "environment", "platform", "undetermined"]},
        "recovery_action": {"enum": ["upgrade_helper", "correct_request", "check_asset_access", "check_asset_integrity", "check_local_storage", "contact_platform_with_task_id", "reconnect_helper", "rebind_files", "none"]},
        "accepted_at": {"type": "string", "format": "date-time"},
        "helper_started_at": {"type": ["string", "null"], "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
