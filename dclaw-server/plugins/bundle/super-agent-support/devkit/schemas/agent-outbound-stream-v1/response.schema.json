{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclaw.deepmega.cn/schemas/agent-outbound-stream-v1/response.schema.json",
  "title": "Agent streaming outbound resource response",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_ref", "status", "mime_type", "size_bytes", "sha256", "expires_at"],
  "properties": {
    "resource_ref": {"type": "string", "pattern": "^res_[0-9a-f]{32}$"},
    "status": {"const": "ready"},
    "mime_type": {"type": "string"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expires_at": {"type": "integer", "minimum": 1}
  }
}
