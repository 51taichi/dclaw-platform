{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aigc.task.assets.localize/1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["material_task_id", "idempotency_key", "assets"],
  "properties": {
    "material_task_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 160},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "usage", "slot", "order", "destination"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "usage": {"enum": ["cover", "timeline_clip", "reference_image", "background_audio", "voice_audio", "subtitle", "overlay", "final_output"]},
          "slot": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
          "order": {"type": "integer", "minimum": 0},
          "destination": {"enum": ["res", "task_root"]}
        }
      }
    }
  }
}
